#!/usr/bin/env zsh

# ZSHENV SSH agent
#
# Use the systemd user ssh-agent (ssh-agent.socket). claude-harness's
# bootstrap.sh enables the socket. No fallback agent is started here: a second
# agent on another socket splits the keys (ssh-add goes to one, tools use the other).

command -v ssh-agent >/dev/null 2>&1 || return 0

if [[ -S "${XDG_RUNTIME_DIR}/ssh-agent.socket" ]]; then
    export SSH_AUTH_SOCK="${XDG_RUNTIME_DIR}/ssh-agent.socket"
elif [[ -o interactive ]]; then
    print -u2 "zshenv-sshagent: ${XDG_RUNTIME_DIR:-\$XDG_RUNTIME_DIR}/ssh-agent.socket missing; run claude-harness bootstrap.sh or: systemctl --user enable --now ssh-agent.socket"
fi
