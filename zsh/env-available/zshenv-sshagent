#!/usr/bin/env zsh

# ZSHENV SSH agent
#
#

# Use the systemd user ssh-agent (ssh-agent.socket) when its socket exists.
# There is deliberately no fallback that starts another agent: it hides a
# missing systemd socket and splits keys across two agents. If the socket is
# missing, run `systemctl --user enable --now ssh-agent.socket` (bootstrap.sh
# in claude-harness does this).
[[ -S "${XDG_RUNTIME_DIR}/ssh-agent.socket" ]] && export SSH_AUTH_SOCK="${XDG_RUNTIME_DIR}/ssh-agent.socket"
