#!/usr/bin/env zsh

# ZSHENV DRONE
#
#

# This should point to your drone token configuration (see https://drone.REDACTED.io/account/token)
if [[ -f `which drone` ]]; then
    . ~/.dotfiles-private/drone/drone.REDACTED.io
fi

# Quickly open current project in drone
function dr() {
    CWD=`pwd`
    BASENAME=`basename $CWD`
    open https://drone.REDACTED.io/REDACTED/$BASENAME
}

# Promote a build to PROD (used by Platypus)
function promote () {
    curl -XPOST -H "Authorization: Bearer $DRONE_TOKEN" "https://drone.REDACTED.io/api/repos/REDACTED/$1/builds/$2/promote?target=production"
}
